{
  "name": "@whenmoon-afk/memory-mcp",
  "version": "3.0.0",
  "description": "Local-first memory database and continuity journal MCP server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "claude-memory-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CONTRACT.md",
    "CHANGELOG.md",
    "RELEASE.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node --input-type=module -e \"process.env.CLAUDE_MEMORY_DATA_DIR='.tmp/claude-memory-mcp-smoke'; process.argv=['node','dist/index.js','setup']; await import('./dist/index.js');\"",
    "test:package-smoke": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:smoke",
    "verify": "npm run check",
    "release:check": "npm audit --omit=dev --audit-level=high && npm run check && npm run test:coverage && npm run test:package-smoke",
    "clean": "node scripts/clean.mjs",
    "prepare": "tsc",
    "prerelease": "npm run release:check",
    "release": "npm run prerelease && git tag v$(node -p \"require('./package.json').version\") && git push origin v$(node -p \"require('./package.json').version\")",
    "prepublishOnly": "npm run clean && npm run release:check"
  },
  "keywords": [
    "mcp",
    "local-first",
    "continuity",
    "handoff",
    "local-memory",
    "ai-memory",
    "sqlite",
    "ai",
    "typescript",
    "memory"
  ],
  "author": "WhenMoon-afk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whenmoon-afk/claude-memory-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/whenmoon-afk/claude-memory-mcp/issues"
  },
  "homepage": "https://github.com/whenmoon-afk/claude-memory-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "express-rate-limit": "^8.2.2",
    "hono": "^4.12.14",
    "path-to-regexp": "^8.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
